# Copy to .env for local development. Never commit real secrets.
# Every backend variable uses the APP_ prefix and is validated at startup (apps/api/config/env.py).

APP_ENVIRONMENT=dev
APP_DEBUG=true
APP_ADMIN_ENABLED=true
# Required (and validated) in staging and production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=
APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Public origin(s) of the web app. Required because the browser talks to Next.js, which proxies to Django.
APP_CSRF_TRUSTED_ORIGINS=["http://localhost:3003"]

APP_DATABASE_URL=postgres://app:app@localhost:54329/app
APP_REDIS_URL=redis://localhost:16379/0

# Credential vault master keys: version:base64(32 random bytes), comma separated.
# Generate one with: python -c "import os,base64;print('v1:'+base64.b64encode(os.urandom(32)).decode())"
APP_VAULT_MASTER_KEYS=
APP_VAULT_ACTIVE_KEY_VERSION=v1

APP_DEFAULT_LOCALE=en
APP_SUPPORTED_LOCALES=["en"]
APP_TIME_ZONE=UTC
APP_LOG_LEVEL=INFO
APP_SENTRY_DSN=

# Google Ads (leave empty until you have them; the Google Ads page lists what is missing).
# OAuth client: Google Cloud console, Google Ads API enabled, redirect URI shown on the Google Ads page.
# Developer token: API Center of your Google Ads manager account.
APP_GOOGLE_OAUTH_CLIENT_ID=
APP_GOOGLE_OAUTH_CLIENT_SECRET=
APP_GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta app (Facebook Login and Marketing API: ads). Developer console > your app > App settings > Basic.
# Optional here: both Meta keys can also be saved on the Meta setup screen.
APP_META_APP_ID=
APP_META_APP_SECRET=

# Instagram (leave empty until you have them; the Instagram page lists what is missing).
# App: Meta developer console, "Instagram API with Instagram login" product. Add the redirect URI shown on
# the Instagram page and the webhook callback URL (<public base>/bff/api/v1/social/instagram/webhook).
APP_INSTAGRAM_APP_ID=
APP_INSTAGRAM_APP_SECRET=
APP_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Public HTTPS origin of the web app; Instagram fetches images and videos from it when publishing.
APP_PUBLIC_BASE_URL=

# Web app
API_URL=http://127.0.0.1:8001

# Development seed (python manage.py seed_dev) creates users like owner@itbcpro.test.
# The shared development password is defined in apps/api/workspaces/management/commands/seed_dev.py.

# Optional: raises the daily quota of Google PageSpeed Insights (or add it on the Connections page).
APP_GOOGLE_PAGESPEED_API_KEY=

# Optional LLM routing (JSON). Defaults: Sonnet medium for planner/writer/analyst; Haiku low for fast_classifier.
# Example with Opus for planning: APP_MODEL_ROUTING={"planner":"claude-opus-5-5","writer":"claude-sonnet-5-5","analyst":"claude-sonnet-5-5","fast_classifier":"claude-haiku-4-5-20251001"}
# APP_MODEL_ROUTING=
# APP_EFFORT_BY_TIER={"planner":"medium","writer":"medium","analyst":"medium","fast_classifier":"low"}
