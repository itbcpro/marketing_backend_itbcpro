# Host nginx site for the platform. Render with:  DOMAIN=app.example.com WEB_HOST_PORT=3010 envsubst '$DOMAIN $WEB_HOST_PORT' < nginx.conf.template
# Then:  certbot --nginx -d "$DOMAIN"   (adds the TLS server block and the HTTP redirect)

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    server_tokens off;
    client_max_body_size 600m;

    location / {
        proxy_pass http://127.0.0.1:${WEB_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}
