# Template for GitHub configuration. Non-secret lines go into the DEPLOY_CONFIG variable; the five generated
# values (POSTGRES_PASSWORD, REDIS_PASSWORD, APP_SECRET_KEY, APP_VAULT_MASTER_KEYS, APP_JWT_SIGNING_KEYS) go into
# one secret each; provider keys go into the optional DEPLOY_EXTRA_ENV secret.
# Generate real values with:  cd apps/api && uv run python ../../infra/deploy/generate_env.py > deploy.env
# Never commit the result. Values here are placeholders.

# Compose / infrastructure
COMPOSE_PROJECT=itbcpro-marketing
# Free loopback port on the server (3001, 3002, 3003, 3010 are taken there).
WEB_HOST_PORT=
POSTGRES_IMAGE=pgvector/pgvector:pg18
REDIS_IMAGE=redis:8-alpine
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Backend (validated at startup by apps/api/config/env.py)
APP_SECRET_KEY=
APP_VAULT_MASTER_KEYS=
APP_VAULT_ACTIVE_KEY_VERSION=v1
APP_JWT_SIGNING_KEYS=
APP_JWT_ACTIVE_KID=k1
# Must contain the public domain plus the internal names used by the web proxy and the health check.
APP_ALLOWED_HOSTS=["app.example.com","api","127.0.0.1","localhost"]
APP_CSRF_TRUSTED_ORIGINS=["https://app.example.com"]
APP_PUBLIC_BASE_URL=https://app.example.com
APP_WEB_BASE_URL=https://app.example.com
APP_WEBAUTHN_RP_ID=app.example.com
APP_ADMIN_ENABLED=false
APP_SIGNUP_ENABLED=false

# Optional providers: add only what you use (see .env.example for the full list).
# APP_ANTHROPIC_API_KEY=
# APP_SENTRY_DSN=
# APP_GOOGLE_OAUTH_CLIENT_ID=
# APP_GOOGLE_OAUTH_CLIENT_SECRET=
# APP_META_APP_ID=
# APP_META_APP_SECRET=
